{
  "info": {
    "name": "电影票订购 App - 交易链路接口（成员C · A文档定稿版）",
    "description": "按成员 A《后端接口文档》(README.md) 逐条对应，覆盖 C 负责的 7 个接口。2026-11-24 定稿：payOrder 只收 orderId（无 payType）；订单列表三 Tab = 不传 / status=0 / status=2；已支付订单取消回 400。导入 Postman 后改环境变量 baseUrl 即可切换 mock 与 A 的真实服务。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000", "description": "本地 mock 用 8000；A 的真实服务是 http://A的IP:9000" },
    { "key": "token", "value": "demo-token", "description": "用 /api/login 拿到的 token 替换" },
    { "key": "cinemaId", "value": "1" },
    { "key": "orderId", "value": "1001" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "0 登录拿token（仅A真实服务需要）",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"phone\": \"13800000001\",\n  \"password\": \"123456\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/login", "host": ["{{baseUrl}}"], "path": ["api", "login"] }
      }
    },
    {
      "name": "getProductList 卖品列表（裸数组, origin_price）",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/getProductList?cinemaId={{cinemaId}}", "host": ["{{baseUrl}}"], "path": ["api", "getProductList"], "query": [{ "key": "cinemaId", "value": "{{cinemaId}}" }] }
      }
    },
    {
      "name": "createOrder 提交订单",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"scheduleId\": 1,\n  \"seats\": [ {\"row\": 5, \"col\": 6}, {\"row\": 5, \"col\": 7} ],\n  \"goods\": [ {\"productId\": 1, \"quantity\": 1} ],\n  \"totalAmount\": 142.00\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/createOrder", "host": ["{{baseUrl}}"], "path": ["api", "createOrder"] }
      }
    },
    {
      "name": "createOrder 异常-金额变价2003",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"scheduleId\": 1,\n  \"seats\": [ {\"row\": 6, \"col\": 1} ],\n  \"totalAmount\": 999.00\n}" },
        "url": { "raw": "{{baseUrl}}/api/createOrder", "host": ["{{baseUrl}}"], "path": ["api", "createOrder"] }
      }
    },
    {
      "name": "payOrder 支付（定稿：只传orderId）",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"orderId\": 1002\n}" },
        "url": { "raw": "{{baseUrl}}/api/payOrder", "host": ["{{baseUrl}}"], "path": ["api", "payOrder"] }
      }
    },
    {
      "name": "cancelOrder 取消（仅待支付可取消）",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"orderId\": 1002\n}" },
        "url": { "raw": "{{baseUrl}}/api/cancelOrder", "host": ["{{baseUrl}}"], "path": ["api", "cancelOrder"] }
      }
    },
    {
      "name": "cancelOrder 异常-已支付不可取消400",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"orderId\": 1001\n}" },
        "url": { "raw": "{{baseUrl}}/api/cancelOrder", "host": ["{{baseUrl}}"], "path": ["api", "cancelOrder"] }
      }
    },
    {
      "name": "getOrderList 订单列表-全部（不传status）",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/getOrderList?pageNum=1&pageSize=10", "host": ["{{baseUrl}}"], "path": ["api", "getOrderList"], "query": [{ "key": "pageNum", "value": "1" }, { "key": "pageSize", "value": "10" }] }
      }
    },
    {
      "name": "getOrderList 订单列表-待支付（status=0）",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/getOrderList?status=0&pageNum=1&pageSize=10", "host": ["{{baseUrl}}"], "path": ["api", "getOrderList"], "query": [{ "key": "status", "value": "0" }, { "key": "pageNum", "value": "1" }, { "key": "pageSize", "value": "10" }] }
      }
    },
    {
      "name": "getOrderList 订单列表-已完成（status=2，定稿）",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/getOrderList?status=2&pageNum=1&pageSize=10", "host": ["{{baseUrl}}"], "path": ["api", "getOrderList"], "query": [{ "key": "status", "value": "2" }, { "key": "pageNum", "value": "1" }, { "key": "pageSize", "value": "10" }] }
      }
    },
    {
      "name": "getOrderDetail 订单详情",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/getOrderDetail?orderId={{orderId}}", "host": ["{{baseUrl}}"], "path": ["api", "getOrderDetail"], "query": [{ "key": "orderId", "value": "{{orderId}}" }] }
      }
    },
    {
      "name": "getOrderDetail 异常-订单不存在2005",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/getOrderDetail?orderId=404", "host": ["{{baseUrl}}"], "path": ["api", "getOrderDetail"], "query": [{ "key": "orderId", "value": "404" }] }
      }
    },
    {
      "name": "getWatchStats 观影统计",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/getWatchStats", "host": ["{{baseUrl}}"], "path": ["api", "getWatchStats"] }
      }
    },
    {
      "name": "异常-未带token返回1001",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/getProductList?cinemaId=1", "host": ["{{baseUrl}}"], "path": ["api", "getProductList"], "query": [{ "key": "cinemaId", "value": "1" }] }
      }
    }
  ]
}
